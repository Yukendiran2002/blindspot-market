# Blindspot Market settings. Copy to .env and fill in. Never commit .env.
# PayPal sandbox REST app (developer.paypal.com -> Apps & Credentials -> Sandbox). Blindspot refuses non-sandbox hosts.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Gemini API key (aistudio.google.com). Optional: without it, explanations use templates and "Ask about your money" is off.
GEMINI_API_KEY=
# Console access. Set a long random string; or BLINDSPOT_OPEN_CONSOLE=1 for local development only.
BLINDSPOT_OPERATOR_KEY=
# Optional: invite code annotators must enter to join.
BLINDSPOT_INVITE=
# Optional paths and port
BLINDSPOT_DB=blindspot.db
PORT=8077
HOST=127.0.0.1
